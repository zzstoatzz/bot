[Unit]
Description=phi: Bluesky agent (docker, loopback :8801 behind cloudflared)
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
# Host networking: tailnet services such as the alerts ledger admit a peer by
# `tailscale whois`, which cannot attribute a connection from Docker's bridge.
# The server binds loopback itself because nothing is published.
Environment=DOCKER_HOST=unix:///var/run/docker.sock
ExecStartPre=-/usr/bin/docker rm -f phi
ExecStart=/usr/bin/docker run --rm --name phi \
  --env-file %h/.config/phi/env \
  --env PORT=8801 --env DEBUG=false --env BOT_NAME=phi \
  --env PERSONALITY_FILE=personalities/phi.md \
  --network host \
  --volume %h/.local/state/phi/data:/data \
  --memory 1g \
  phi:current python -m uvicorn bot.main:app --host 127.0.0.1 --port 8801
ExecStop=/usr/bin/docker stop -t 20 phi
# The watchdog exits the process when polling stalls; always restarting keeps
# an upstream outage from exhausting a finite restart budget.
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
